# Copiar para .env e ajustar. Todos têm valor por omissão, por isso o
# ficheiro pode ficar vazio se os valores abaixo servirem.

# Fuso horário do container, usado pelo cron das 05:30 e 06:30.
TZ=Europe/Lisbon

# Tag da imagem local carregada com `docker load`.
GARMIN_IMAGE_TAG=1.0

# Nome do ficheiro GGUF dentro de ./models. Só usado com --profile llm.
# Sugestão para 2 núcleos: um 4B em Q4_K_M.
MODEL_FILE=model.gguf

# Núcleos entregues ao modelo. Numa NAS de 2 núcleos deixa 4 (o llama.cpp
# lida bem com sobreposição); num PC, cerca de metade dos que tens.
LLM_THREADS=4

# Janela de contexto do modelo. O prompt do plano leva 14 dias de sessões;
# 2048 chega, mas 4096 dá folga e custa pouca memória.
LLM_CTX=8192

# Memória para o modelo. 6g chega para um 4B; um 12B precisa de 12g. Se o
# limite ficar abaixo do modelo, o container morre sem explicação útil.
LLM_MEM=6g

# Quanto tempo esperar por cada resposta do modelo. Um 12B em dois núcleos
# demora mais de dez minutos por secção, e o relatório corre de madrugada,
# sem ninguém à espera. Baixa isto só se preferires secções vazias a esperar.
LLM_TIMEOUT=3600

# Dono dos ficheiros escritos em data/ e models/. Sem isto ficam de root, e
# não os consegues abrir nem apagar a partir do teu utilizador. Descobre os
# teus com: id -u  e  id -g   (no DSM, id o-teu-utilizador).
PUID=1000
PGID=1000

# Interface web. WEB_BIND=127.0.0.1 restringe ao próprio computador; o valor
# por omissão aceita ligações de toda a rede local, que é cómodo mas expõe o
# formulário das credenciais a quem estiver na mesma rede.
WEB_BIND=0.0.0.0
WEB_PORT=8090
